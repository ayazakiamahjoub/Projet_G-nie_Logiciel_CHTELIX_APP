<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CHITELIX - Prédiction IA</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&display=swap');

        :root {
            --marine: #12344d;
            --bleu: #1f6fa8;
            --bleu-clair: #8fb8d6;
            --fond: #f4f6f8;
            --trait: #dde3e9;
            --trait-fort: #c4ced8;
            --texte: #1c2833;
            --texte-doux: #5d6b78;
            --succes: #1a7f5a;
            --danger: #b3382c;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Public Sans', 'Segoe UI', Tahoma, sans-serif;
        }

        body {
            min-height: 100vh;
            padding: 2.5rem 1.25rem;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            font-size: 0.97rem;
            line-height: 1.55;
            color: var(--texte);
            background-color: var(--fond);
            font-variant-numeric: tabular-nums;
        }

        .card {
            width: 100%;
            max-width: 560px;
            padding: 1.75rem 2rem 2rem;
            background: #fff;
            border: 1px solid var(--trait);
            border-top: 3px solid var(--bleu);
            border-radius: 8px;
            box-shadow: 0 1px 2px rgba(18, 52, 77, 0.05);
        }

        h1 {
            font-size: 1.3rem;
            font-weight: 700;
            line-height: 1.3;
            color: var(--marine);
            margin-bottom: 0.25rem;
        }

        .description {
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            font-size: 0.92rem;
            color: var(--texte-doux);
            border-bottom: 1px solid var(--trait);
        }

        .form-group { margin-bottom: 1.1rem; }

        label {
            display: block;
            margin-bottom: 0.35rem;
            font-size: 0.88rem;
            font-weight: 600;
        }

        input[type="number"] {
            width: 100%;
            padding: 0.7rem 0.85rem;
            font-size: 0.97rem;
            color: var(--texte);
            background: #fff;
            border: 1px solid var(--trait-fort);
            border-radius: 6px;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        input[type="number"]::placeholder { color: #9aa7b3; }
        input[type="number"]:hover { border-color: #9aaab8; }

        input[type="number"]:focus {
            outline: none;
            border-color: var(--bleu);
            box-shadow: 0 0 0 3px rgba(31, 111, 168, 0.2);
        }

        button {
            width: 100%;
            margin-top: 0.4rem;
            padding: 0.8rem 1rem;
            font-size: 0.97rem;
            font-weight: 600;
            color: #fff;
            background-color: var(--bleu);
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: background-color 0.15s;
        }

        button:hover { background-color: var(--marine); }
        button:active { transform: translateY(1px); }

        button:focus-visible {
            outline: 3px solid rgba(31, 111, 168, 0.45);
            outline-offset: 2px;
        }

        button:disabled {
            background-color: #9aaab8;
            cursor: progress;
            transform: none;
        }

        .erreur {
            margin-top: 0.9rem;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--danger);
        }

        .erreur:empty { display: none; }

        /* Résultat */
        #resultat {
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--trait);
        }

        .total-ligne {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 1rem;
        }

        .total-ligne span:first-child {
            font-size: 0.88rem;
            font-weight: 500;
            color: var(--texte-doux);
        }

        .total {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--marine);
        }

        .tendance {
            margin: 0.1rem 0 1.25rem;
            font-size: 0.88rem;
            color: var(--texte-doux);
            text-align: right;
        }

        /* Graphique : 3 mois saisis + mois prévu */
        .graphe {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0.75rem;
            padding: 1rem 1rem 0.75rem;
            border: 1px solid var(--trait);
            border-radius: 6px;
        }

        .colonne {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            text-align: center;
        }

        .colonne .valeur {
            margin-bottom: 0.3rem;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--marine);
        }

        .zone-barre {
            height: 120px;
            display: flex;
            align-items: flex-end;
            border-bottom: 1px solid var(--trait-fort);
        }

        .barre {
            width: 100%;
            min-height: 2px;
            background: var(--bleu);
            border-radius: 3px 3px 0 0;
            transform-origin: bottom;
            animation: monter 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
        }

        /* La valeur prévue est hachurée pour la distinguer des données saisies */
        .colonne.prevue .barre {
            background: repeating-linear-gradient(
                45deg, var(--bleu), var(--bleu) 6px, var(--bleu-clair) 6px, var(--bleu-clair) 12px
            );
        }

        .colonne .libelle {
            margin-top: 0.4rem;
            font-size: 0.78rem;
            color: var(--texte-doux);
        }

        @keyframes monter {
            from { transform: scaleY(0); }
            to   { transform: scaleY(1); }
        }

        .message {
            margin-top: 1.1rem;
            padding: 0.75rem 0.9rem;
            font-size: 0.93rem;
            font-weight: 600;
            background: var(--fond);
            border: 1px solid var(--trait);
            border-left: 3px solid var(--trait-fort);
            border-radius: 6px;
        }

        .message[data-etat="succes"] { color: var(--succes); border-left-color: var(--succes); }
        .message[data-etat="danger"] { color: var(--danger); border-left-color: var(--danger); }

        @media (max-width: 560px) {
            body { padding: 1rem 0.75rem; }
            .card { padding: 1.25rem 1.1rem 1.5rem; }
            .total { font-size: 1.5rem; }
        }

        @media (prefers-reduced-motion: reduce) {
            button, input[type="number"] { transition: none; }
            .barre { animation: none; }
        }
    </style>
</head>
<body>

    <main class="card">
        <h1>🤖 Prédiction IA des collectes</h1>
        <p class="description">
            Saisissez l'historique des 3 derniers mois : le modèle Python (régression linéaire)
            estime la collecte du mois suivant.
        </p>

        <form id="formPrediction" novalidate>
            <div class="form-group">
                <label for="m1">Mois 1 (kg)</label>
                <input type="number" id="m1" placeholder="Ex : 500" min="0" inputmode="decimal">
            </div>
            <div class="form-group">
                <label for="m2">Mois 2 (kg)</label>
                <input type="number" id="m2" placeholder="Ex : 600" min="0" inputmode="decimal">
            </div>
            <div class="form-group">
                <label for="m3">Mois 3 (kg)</label>
                <input type="number" id="m3" placeholder="Ex : 700" min="0" inputmode="decimal">
            </div>

            <button type="submit" id="btnPredict">Lancer la prédiction</button>
            <p id="erreur" class="erreur" role="alert"></p>
        </form>

        <div id="resultat" aria-live="polite" hidden>
            <div class="total-ligne">
                <span>Collecte prévue au mois 4</span>
                <span class="total" id="valeurPredict">0 kg</span>
            </div>
            <p class="tendance" id="tendance"></p>

            <div class="graphe" id="graphe" role="img" aria-label="Historique des 3 mois et prévision du mois 4"></div>

            <p class="message" id="messageLogistique"></p>
        </div>
    </main>

    <script>
        const API_URL = 'http://127.0.0.1:5000/predire';
        const API_TIMEOUT_MS = 8000;
        const SEUIL_CAMION = 2500; // kg, capacité de l'usine

        const $ = (id) => document.getElementById(id);
        const formatNombre = (v, max = 0) =>
            new Intl.NumberFormat('fr-FR', { maximumFractionDigits: max }).format(v);
        const formatKg = (v) => formatNombre(v, 2) + ' kg';

        // Renvoie un nombre, ou NaN si le champ est vide
        function lireNombre(id) {
            const valeur = parseFloat($(id).value);
            return Number.isFinite(valeur) ? valeur : NaN;
        }

        // Appel à l'API Flask, avec délai maximum
        async function demanderPrediction(m1, m2, m3) {
            const controleur = new AbortController();
            const minuteur = setTimeout(() => controleur.abort(), API_TIMEOUT_MS);

            try {
                const reponse = await fetch(API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ m1, m2, m3 }),
                    signal: controleur.signal
                });
                const donnees = await reponse.json();

                if (!reponse.ok) {
                    throw new Error(donnees.erreur || 'Le serveur a refusé la requête.');
                }
                return donnees.prediction;
            } finally {
                clearTimeout(minuteur);
            }
        }

        // Barres : 3 mois saisis + mois prévu (hachuré)
        function afficherGraphique(historique, prediction) {
            const valeurs = [...historique, prediction];
            const max = Math.max(...valeurs, 1);
            const graphe = $('graphe');
            graphe.replaceChildren();

            valeurs.forEach((valeur, i) => {
                const prevue = i === valeurs.length - 1;

                const colonne = document.createElement('div');
                colonne.className = 'colonne' + (prevue ? ' prevue' : '');

                const etiquetteValeur = document.createElement('span');
                etiquetteValeur.className = 'valeur';
                etiquetteValeur.textContent = formatNombre(Math.round(valeur));

                const zone = document.createElement('div');
                zone.className = 'zone-barre';
                const barre = document.createElement('div');
                barre.className = 'barre';
                barre.style.height = `${(valeur / max) * 100}%`;
                zone.append(barre);

                const libelle = document.createElement('span');
                libelle.className = 'libelle';
                libelle.textContent = prevue ? 'Mois 4 (prévu)' : `Mois ${i + 1}`;

                colonne.append(etiquetteValeur, zone, libelle);
                graphe.append(colonne);
            });
        }

        function afficherTendance(dernierMois, prediction) {
            const element = $('tendance');
            if (dernierMois <= 0) {
                element.textContent = '';
                return;
            }
            const variation = ((prediction - dernierMois) / dernierMois) * 100;
            if (Math.abs(variation) < 0.5) {
                element.textContent = 'Stable par rapport au mois 3';
            } else {
                const sens = variation > 0 ? 'Hausse' : 'Baisse';
                element.textContent = `${sens} de ${formatNombre(Math.abs(variation), 1)} % par rapport au mois 3`;
            }
        }

        $('formPrediction').addEventListener('submit', async (event) => {
            event.preventDefault();

            const bouton = $('btnPredict');
            const erreur = $('erreur');
            const resultat = $('resultat');
            const message = $('messageLogistique');
            const historique = ['m1', 'm2', 'm3'].map(lireNombre);

            if (historique.some((v) => !Number.isFinite(v) || v < 0)) {
                erreur.textContent = '⚠️ Renseignez les 3 mois avec des valeurs positives ou nulles.';
                resultat.hidden = true;
                return;
            }

            erreur.textContent = '';
            bouton.disabled = true;
            bouton.textContent = 'Calcul en cours…';

            try {
                const prediction = await demanderPrediction(...historique);

                $('valeurPredict').textContent = formatKg(Math.round(prediction));
                afficherTendance(historique[2], prediction);
                afficherGraphique(historique, prediction);

                if (prediction >= SEUIL_CAMION) {
                    message.textContent = '🚚 Seuil de 2 500 kg dépassé : prévoyez un grand camion.';
                    message.dataset.etat = 'danger';
                } else {
                    message.textContent = '✅ Collecte normale prévue : un petit camion suffira.';
                    message.dataset.etat = 'succes';
                }
                resultat.hidden = false;
            } catch (err) {
                resultat.hidden = true;
                // TypeError = serveur injoignable ; AbortError = délai dépassé
                const injoignable = err instanceof TypeError || err.name === 'AbortError';
                erreur.textContent = injoignable
                    ? "⚠️ Le serveur Python ne répond pas. Lancez 'python app.py'."
                    : `⚠️ ${err.message}`;
            } finally {
                bouton.disabled = false;
                bouton.textContent = 'Lancer la prédiction';
            }
        });
    </script>

</body>
</html>
